# Copy this file to `.env`. Nuxt reads it on `pnpm dev` and `pnpm build`.
# Never commit `.env`: it holds Admin API credentials.

# Shopware 6 Admin API integration (Settings > System > Integrations).
# These stay in private runtimeConfig and are used only by the server routes.
NUXT_AMAZON_PAY_SHOPWARE_ADMIN_API_ENDPOINT=
NUXT_AMAZON_PAY_SHOPWARE_ADMIN_API_CREDENTIALS_CLIENT_ID=
NUXT_AMAZON_PAY_SHOPWARE_ADMIN_API_CREDENTIALS_CLIENT_SECRET=
