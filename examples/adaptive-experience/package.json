{
  "private": true,
  "name": "example-adaptive-experience",
  "description": "R&D spike: adaptive storefront driven by a versioned ExperiencePlan",
  "type": "module",
  "scripts": {
    "dev": "nuxt prepare && nuxt dev",
    "build": "nuxt prepare && nuxt build",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "typecheck": "nuxt prepare && nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "nuxt": "4.4.8",
    "vue": "3.5.39",
    "vue-starter-template": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@shopware/api-gen": "canary",
    "@unocss/core": "66.7.5",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  },
  "overrides": {
    "glob": "^13",
    "eslint-visitor-keys": "^4"
  }
}
