{
  "name": "react-starter-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "next typegen && tsc --noEmit",
    "generate-types": "shopware-api-gen generate --apiType=store"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@shopware/api-client": "canary",
    "@shopware/cms-base-layer-react": "workspace:*",
    "@shopware/design-tokens": "workspace:*",
    "@shopware/helpers": "canary",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@shopware/api-gen": "canary",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  }
}
