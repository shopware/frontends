{
  "name": "react-starter-template",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "generate-types": "shopware-api-gen generate --apiType=store"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@shopware/api-client": "canary",
    "@shopware/cms-base-layer-react": "workspace:*",
    "@shopware/design-tokens": "workspace:*",
    "@shopware/helpers": "canary",
    "js-cookie": "3.0.8",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@shopware/api-gen": "canary",
    "@tailwindcss/postcss": "4.3.2",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
