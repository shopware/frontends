{
  "name": "lumora-demo-store",
  "version": "0.0.7",
  "description": "Lumora Demo Store - Modern Home Scents",
  "private": true,
  "author": "Shopware",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopware/frontends.git"
  },
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "nuxt prepare && nuxt dev",
    "build": "nuxt prepare && nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "nuxt prepare && nuxi typecheck",
    "test": "nuxt prepare && vitest run",
    "generate-types": "shopware-api-gen generate --apiType=store"
  },
  "dependencies": {
    "@shopware/api-client": "canary",
    "@shopware/helpers": "canary",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-starter-template": "workspace:*"
  },
  "devDependencies": {
    "@shopware/api-gen": "canary",
    "@unocss/core": "66.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0"
  },
  "overrides": {
    "glob": "^13",
    "eslint-visitor-keys": "^4"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "oxfmt",
      "oxlint",
      "sharp",
      "vue-demi"
    ]
  }
}
