# Template for Nuxt public runtime config.
# Copy or rename this file to `.env` (or inject these as env vars) to override nuxt.config.ts defaults.
# https://developer.shopware.com/frontends/getting-started/templates.html

# Your Shopware 6 Store API endpoint
# https://developer.shopware.com/frontends/installation.html
NUXT_PUBLIC_SHOPWARE_ENDPOINT=https://demo-frontends.shopware.store/store-api/

# Sales Channel access token (Settings > Sales Channel > API access in Shopware admin)
# https://developer.shopware.com/frontends/installation.html
NUXT_PUBLIC_SHOPWARE_ACCESS_TOKEN=SWSCNWDGMUWZM0TLVUU0YKLQVW

# Storefront domain registered in your Sales Channel (Settings > Sales Channel > Domains).
# Registration, newsletter and password recovery send it as storefrontUrl, and Shopware
# rejects any value that is not a listed domain. localhost never is, so set it for local
# development. The public demo backend lists exactly this one domain.
# In production, leave it empty: window.location.origin is used.
NUXT_PUBLIC_SHOPWARE_DEV_STOREFRONT_URL=https://demo-frontends.shopware.store/figma

# Optional private SSR endpoint. Set this only if server-side requests should
# use a different internal URL than the public browser endpoint.
NUXT_SHOPWARE_ENDPOINT=

# Optional public URL of the storefront, e.g. https://your-shop.com.
# /sitemap.xml builds its links from it. Without it, the request host is used,
# which is wrong behind a proxy that rewrites the Host header.
NUXT_PUBLIC_SITE_URL=

# Optional. true turns on the UCP checkout handoff for the agentic-commerce
# plugin: the /checkout/continue page, the UCP proxy and the Link header.
NUXT_PUBLIC_AGENTIC_HANDOFF_ENABLED=

# Optional, for the UCP checkout handoff (agentic-commerce plugin). Hosts this
# storefront answers on, comma separated, with a port where one is used
# ("shop.example.com,localhost:3000"). Set it in production, so a request
# cannot choose where continue_url points. Empty trusts the request host.
NUXT_AGENTIC_HANDOFF_STOREFRONT_HOSTS=

# Optional origin of the Shopware instance running that plugin, without
# /store-api/. A sub-path such as https://host/shop is kept. Empty: the
# Store API endpoint without that suffix.
NUXT_AGENTIC_HANDOFF_SHOPWARE_ORIGIN=

# Type generation (development only) — used by `pnpm generate-types` (@shopware/api-gen)
# https://developer.shopware.com/frontends/packages/api-client.html

# Base URL of your Shopware instance (without /store-api/ suffix)
OPENAPI_JSON_URL=https://demo-frontends.shopware.store

# Sales Channel access key for fetching the OpenAPI schema
OPENAPI_ACCESS_KEY=
