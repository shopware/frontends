{
  "name": "vue-starter-template",
  "version": "0.2.0",
  "description": "Shopware Vue Starter Template",
  "private": true,
  "author": "Shopware",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopware/frontends.git"
  },
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./uno.config": "./uno.config.ts"
  },
  "scripts": {
    "dev": "nuxt prepare && nuxt dev",
    "build": "nuxt prepare && nuxt build",
    "nuxt-prepare": "nuxt prepare",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "nuxt prepare && nuxi typecheck",
    "generate-types": "shopware-api-gen generate --apiType=store"
  },
  "dependencies": {
    "@iconify-json/carbon": "1.2.30",
    "@iconify/utils": "3.1.7",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxt/vite-builder": "4.6.4",
    "@nuxtjs/i18n": "10.4.0",
    "@regle/core": "1.25.2",
    "@regle/rules": "1.25.2",
    "@shopware/api-client": "canary",
    "@shopware/cms-base-layer": "canary",
    "@shopware/composables": "canary",
    "@shopware/helpers": "canary",
    "@shopware/nuxt-module": "canary",
    "@shopware/unocss-design-tokens-layer": "canary",
    "@unocss/core": "66.13.0",
    "@unocss/nuxt": "66.13.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "4.6.4",
    "scule": "1.3.0",
    "unocss": "66.13.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@shopware/api-gen": "canary",
    "@vue/compiler-sfc": "3.5.45",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "glob": "^13",
    "eslint-visitor-keys": "^4"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "oxfmt",
      "oxlint",
      "sharp",
      "vue-demi"
    ]
  }
}
