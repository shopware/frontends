{
  "name": "vue-agentic-handoff",
  "version": "0.0.0",
  "description": "Shopware Frontends template that takes over checkouts handed off by AI agents over UCP",
  "private": true,
  "author": "Shopware",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopware/frontends.git"
  },
  "main": "./nuxt.config.ts",
  "scripts": {
    "dev": "nuxt prepare && nuxt dev",
    "build": "nuxt prepare && nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "nuxt prepare && nuxi typecheck",
    "generate-types": "shopware-api-gen generate --apiType=store"
  },
  "dependencies": {
    "@shopware/api-client": "canary",
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "vue-starter-template": "workspace:*"
  },
  "devDependencies": {
    "@shopware/api-gen": "canary",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "oxfmt",
      "oxlint",
      "sharp",
      "vue-demi"
    ]
  }
}
