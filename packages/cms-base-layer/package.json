{
  "name": "@shopware/cms-base-layer",
  "version": "4.0.0",
  "description": "Vue CMS Nuxt Layer for Shopware",
  "author": "Shopware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopware/frontends.git"
  },
  "homepage": "https://developer.shopware.com/frontends/concepts/shopping-experiences.html",
  "keywords": [
    "Shopware",
    "Vue",
    "CMS",
    "Nuxt",
    "Layer"
  ],
  "bugs": {
    "url": "https://github.com/shopware/frontends/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "app",
    "component-dirs.json",
    "index.d.ts",
    "nuxt.config.ts"
  ],
  "scripts": {
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "pnpm nuxt prepare && tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iconify-json/carbon": "1.2.25",
    "@nuxt/image": "2.1.0",
    "@nuxt/kit": "4.5.2",
    "@shopware/api-client": "workspace:*",
    "@shopware/composables": "workspace:*",
    "@shopware/helpers": "workspace:*",
    "@tresjs/cientos": "5.7.2",
    "@tresjs/nuxt": "^5.6.3",
    "@vuelidate/core": "2.0.3",
    "@vuelidate/validators": "2.0.4",
    "@vueuse/core": "14.4.0",
    "entities": "8.0.0",
    "scule": "1.3.0",
    "html-to-ast": "0.0.6",
    "three": "0.183.2",
    "vue": "3.5.41",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@nuxt/schema": "4.5.2",
    "@types/three": "0.182.0",
    "@typescript/native-preview": "7.0.0-dev.20260205.1",
    "@vitest/coverage-v8": "4.1.10",
    "nuxt": "4.5.2",
    "tsconfig": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "vue-router": "5.2.0",
    "vue-tsc": "3.3.9"
  }
}
