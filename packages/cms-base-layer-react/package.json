{
  "name": "@shopware/cms-base-layer-react",
  "version": "0.0.0",
  "description": "React Server Components for Shopware Shopping Experiences (CMS) pages, the React counterpart of @shopware/cms-base-layer",
  "author": "Shopware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopware/frontends.git"
  },
  "homepage": "https://developer.shopware.com/frontends/concepts/shopping-experiences.html",
  "keywords": [
    "Shopware",
    "React",
    "Next.js",
    "CMS",
    "Shopping Experiences"
  ],
  "bugs": {
    "url": "https://github.com/shopware/frontends/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types/index.ts",
    "./styles.css": "./src/assets/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "shopware.d.ts"
  ],
  "scripts": {
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt --write . && pnpm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shopware/api-client": "workspace:*",
    "@shopware/helpers": "workspace:*",
    "defu": "6.1.7",
    "html-react-parser": "6.1.8",
    "scule": "1.3.0",
    "xss": "1.0.15"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsconfig": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
