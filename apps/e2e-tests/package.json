{
  "name": "e2e-tests",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test:e2e": "playwright test --grep @frontends",
    "test:e2e:ui": "playwright test --ui --grep @frontends",
    "test:examples": "playwright test -c examples.config.ts checkCodeExamples.spec.ts",
    "lint": "oxlint . && oxfmt --check . && pnpm run lint:selectors",
    "lint:selectors": "if grep -rnE 'getByTestId|data-testid' tests; then echo 'Move these selectors into page-objects/.' >&2; exit 1; fi",
    "lint:fix": "oxlint --fix . && oxfmt --write .",
    "start": "npx http-server"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@faker-js/faker": "10.6.0",
    "@stackblitz/sdk": "1.11.1",
    "dotenv": "18.0.10",
    "http-server": "14.1.1"
  }
}
